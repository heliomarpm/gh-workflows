{
  "name": "gh-workflows",
  "version": "0.0.1",
  "description": "Reusable GitHub Actions and workflows built with TypeScript and Node.js",
  "author": "Heliomar P. Marques",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/heliomarpm/gh-workflows#readme",
  "bugs": {
    "url": "https://github.com/heliomarpm/gh-workflows/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliomarpm/gh-workflows.git"
  },
  "keywords": ["github-actions", "ci-cd", "reusable-workflows"],
  "license": "MIT",
  "scripts": {
    "ncu": "npx npm-check-updates -u",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "build:changelog": "ncc build src/actions/changelog.ts -o dist/changelog --minify --source-map",
    "build:release": "ncc build src/actions/release.ts -o dist/release --minify --source-map",
    "build": "npm run build:changelog && npm run build:release"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
